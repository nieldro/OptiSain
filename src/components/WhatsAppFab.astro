---
import Icon from '@/components/Icon.astro';
import { waLink } from '@/config';
---

<a
  href={waLink('Hola OptiSain, quiero cotizar un proyecto.')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  data-wa-fab
  class="wa-fab fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-amber text-obsidian shadow-[0_10px_24px_-8px_rgba(0,0,0,0.7)] md:hidden"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>

<style>
  .wa-fab {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wa-fab[data-show] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
</style>

<script>
  // Aparece al salir del hero y se esconde cuando ya se ve el formulario de contacto.
  const fab = document.querySelector<HTMLElement>('[data-wa-fab]');
  const hero = document.getElementById('top');
  const contact = document.getElementById('contacto');

  if (fab && hero) {
    let heroVisible = true;
    let contactVisible = false;
    const update = () => {
      if (!heroVisible && !contactVisible) fab.setAttribute('data-show', '');
      else fab.removeAttribute('data-show');
    };
    new IntersectionObserver((e) => {
      heroVisible = e[0]?.isIntersecting ?? true;
      update();
    }).observe(hero);
    if (contact) {
      new IntersectionObserver((e) => {
        contactVisible = e[0]?.isIntersecting ?? false;
        update();
      }, { threshold: 0.25 }).observe(contact);
    }
  }
</script>
