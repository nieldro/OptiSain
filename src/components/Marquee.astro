---
import Icon from '@/components/Icon.astro';

const items = [
  'Páginas web',
  'Tiendas online',
  'Chatbots con IA',
  'Automatizaciones',
  'Dashboards',
  'Branding',
  'Publicidad digital',
  'SEO',
  'Redes sociales',
];
---

<div class="relative overflow-hidden border-y border-gray/40 bg-gunmetal/35 py-5" aria-hidden="true" data-marquee-wrap>
  <div class="flex w-max gap-10 will-change-transform" data-marquee>
    {
      Array.from({ length: 2 }).map(() => (
        <div class="flex items-center gap-10">
          {items.map((item) => (
            <span class="flex items-center gap-10 whitespace-nowrap">
              <span class="font-heading text-lg font-semibold tracking-wide text-gainsboro sm:text-xl">
                {item}
              </span>
              <Icon name="star" class="h-3.5 w-3.5 text-silver" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  import gsap from 'gsap';

  // La cinta avanza sola y se acelera (y se inclina) con la velocidad del scroll.
  const track = document.querySelector<HTMLElement>('[data-marquee]');
  const wrap = document.querySelector<HTMLElement>('[data-marquee-wrap]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (track && wrap && !reduce) {
    let x = 0;
    let lastY = window.scrollY;
    let boost = 0;
    let skew = 0;
    let hover = false;
    let mul = 1;
    wrap.addEventListener('pointerenter', () => (hover = true));
    wrap.addEventListener('pointerleave', () => (hover = false));

    gsap.ticker.add((_time, dt) => {
      const y = window.scrollY;
      const vel = y - lastY;
      lastY = y;

      boost += (Math.min(Math.abs(vel), 90) * 9 - boost) * 0.08;
      skew += (Math.max(-7, Math.min(7, -vel * 0.18)) - skew) * 0.12;
      mul += ((hover ? 0.12 : 1) - mul) * 0.08;

      // el periodo es lo que separa el inicio de la 1.ª mitad del de la 2.ª (incluye el gap)
      const period = (track.children[1] as HTMLElement).offsetLeft - (track.children[0] as HTMLElement).offsetLeft;
      x -= ((52 + boost) * mul * dt) / 1000;
      if (x <= -period) x += period;
      track.style.transform = `translate3d(${x}px,0,0) skewX(${skew}deg)`;
    });
  }
</script>
