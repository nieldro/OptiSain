---
import Icon from '@/components/Icon.astro';

const items = [
  'Páginas web',
  'Tiendas online',
  'Chatbots con IA',
  'Automatizaciones',
  'Dashboards',
  'Branding',
  'Publicidad digital',
  'SEO',
  'Redes sociales',
];
---

<div class="relative overflow-hidden border-y border-gray/40 bg-gunmetal/35 py-5" aria-hidden="true">
  <div class="flex w-max animate-[marquee_32s_linear_infinite] gap-10 hover:[animation-play-state:paused] motion-reduce:animate-none">
    {
      Array.from({ length: 2 }).map(() => (
        <div class="flex items-center gap-10">
          {items.map((item) => (
            <span class="flex items-center gap-10 whitespace-nowrap">
              <span class="font-heading text-lg font-semibold tracking-wide text-gainsboro sm:text-xl">
                {item}
              </span>
              <Icon name="star" class="h-3.5 w-3.5 text-silver" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
