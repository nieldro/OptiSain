---
import { navLinks } from '@/data/site';
import { INSTAGRAM_URL, INSTAGRAM_HANDLE, CONTACT_EMAIL } from '@/config';
---

<footer class="border-t border-gray/25 py-14">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <a href="#top" aria-label="OptiSain, inicio">
        <img
          src="/logo/optisain-logo-gainsboro.svg"
          alt="OptiSain"
          class="h-8 w-auto"
          width="140"
          height="36"
        />
      </a>

      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-silver hover:text-gainsboro">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-4">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-silver hover:text-amber">
          {INSTAGRAM_HANDLE}
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="text-sm text-silver hover:text-amber">
          {CONTACT_EMAIL}
        </a>
      </div>
    </div>

    <p class="mt-10 text-center text-xs text-silver">© 2026 OptiSain. Hecho en Colombia.</p>
  </div>
</footer>
