---
interface Props {
  class?: string;
  size?: number;
  tilt?: number;
  speed?: number;
  squash?: number;
}
const { class: cls = '', size = 1000, tilt = -14, speed = 52, squash = 0.3 } = Astro.props;
---

<div
  class:list={['orbit-decor pointer-events-none absolute', cls]}
  style={`--size:${size}px;--tilt:${tilt}deg;--speed:${speed}s;--squash:${squash}`}
  aria-hidden="true"
>
  <div class="od-plane">
    <div class="od-ring"></div>
    <div class="od-ring od-r2"></div>
    <div class="od-ring od-r3"></div>
    <div class="od-spin">
      <i class="od-dot"></i>
    </div>
    <div class="od-spin od-spin-b">
      <i class="od-dot od-dot-b"></i>
    </div>
  </div>
</div>

<style>
  .orbit-decor {
    width: min(var(--size), 150vw);
    aspect-ratio: 1;
  }

  .od-plane {
    position: absolute;
    inset: 0;
    transform: rotate(var(--tilt)) scaleY(var(--squash));
  }

  .od-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid rgba(147, 155, 170, 0.2);
  }

  .od-r2 {
    inset: 13%;
    border-color: rgba(147, 155, 170, 0.14);
  }

  .od-r3 {
    inset: 27%;
    border-color: rgba(255, 181, 71, 0.16);
  }

  .od-spin {
    position: absolute;
    inset: 0;
    animation: od-spin var(--speed) linear infinite;
  }

  .od-spin-b {
    inset: 13%;
    animation-duration: calc(var(--speed) * 0.7);
    animation-direction: reverse;
  }

  .od-dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 9999px;
    background: var(--color-amber);
    box-shadow: 0 0 16px 4px rgba(255, 181, 71, 0.5);
  }

  .od-dot-b {
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    background: var(--color-gainsboro);
    box-shadow: 0 0 10px 2px rgba(211, 216, 226, 0.45);
  }

  @keyframes od-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .od-spin {
      animation: none;
    }
  }
</style>
