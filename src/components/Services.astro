---
import Icon from '@/components/Icon.astro';
import { lines, services, combos } from '@/data/services';
import { waLink } from '@/config';
---

<section id="servicios" class="relative py-24 sm:py-32" aria-label="Servicios">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <h2 class="text-balance font-heading text-3xl font-bold text-gainsboro sm:text-4xl" data-reveal>
        Todo lo que tu negocio necesita para crecer en línea
      </h2>
      <p class="mt-4 text-silver" data-reveal>
        Elige una línea o mira todos los servicios. Cada uno con un alcance claro, sin precios
        escondidos: cotiza directo por WhatsApp.
      </p>

      <div class="mt-8 flex items-center justify-center gap-6 sm:gap-10" data-reveal>
        <div class="text-center">
          <p class="font-heading text-3xl font-bold text-amber sm:text-4xl" data-counter data-target={services.length}>
            {services.length}
          </p>
          <p class="mt-1 text-xs uppercase tracking-widest text-silver">Servicios</p>
        </div>
        <div class="h-10 w-px bg-gray/40" aria-hidden="true"></div>
        <div class="text-center">
          <p class="font-heading text-3xl font-bold text-amber sm:text-4xl" data-counter data-target={lines.length}>
            {lines.length}
          </p>
          <p class="mt-1 text-xs uppercase tracking-widest text-silver">Líneas</p>
        </div>
        <div class="h-10 w-px bg-gray/40" aria-hidden="true"></div>
        <div class="text-center">
          <p class="font-heading text-3xl font-bold text-amber sm:text-4xl" data-counter data-target={combos.length}>
            {combos.length}
          </p>
          <p class="mt-1 text-xs uppercase tracking-widest text-silver">Combos</p>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap justify-center gap-2.5"
      role="group"
      aria-label="Filtrar servicios por línea"
      data-filters
    >
      <button
        type="button"
        class="min-h-11 rounded-full border border-gray/60 px-4 py-2 text-sm font-medium text-gainsboro transition-colors hover:border-gainsboro data-[active=true]:border-amber data-[active=true]:bg-amber data-[active=true]:text-obsidian"
        data-filter="todos"
        data-active="true"
        aria-pressed="true"
      >
        Todos
      </button>
      {
        lines.map((line) => (
          <button
            type="button"
            class="min-h-11 rounded-full border border-gray/60 px-4 py-2 text-sm font-medium text-gainsboro transition-colors hover:border-gainsboro data-[active=true]:border-amber data-[active=true]:bg-amber data-[active=true]:text-obsidian"
            data-filter={line.id}
            data-active="false"
            aria-pressed="false"
          >
            {line.label}
          </button>
        ))
      }
    </div>

    <div
      class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal-group
      data-services-grid
    >
      {
        services.map((service) => (
          <article
            class="group relative overflow-hidden rounded-2xl border border-gray/50 bg-gunmetal/35 p-6 transition-shadow [transform-style:preserve-3d]"
            data-reveal
            data-tilt
            data-service-card
            data-service-line={service.line}
          >
            <div
              class="pointer-events-none absolute -inset-10 opacity-0 transition-opacity duration-300"
              data-tilt-glow
              style="background: radial-gradient(220px circle at center, rgba(255,181,71,0.18), transparent 70%);"
            />
            <div class="relative flex h-12 w-12 items-center justify-center">
              <span class="pointer-events-none absolute inset-[-5px] rounded-full border border-dashed border-amber/0 transition-colors duration-500 group-hover:border-amber/70 group-hover:animate-[spin_3.5s_linear_infinite]" />
              <div class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-obsidian text-gainsboro">
                <Icon name={service.icon} class="h-6 w-6" />
              </div>
            </div>
            <h3 class="relative mt-5 font-heading text-xl font-semibold text-gainsboro">
              {service.name}
            </h3>
            <p class="relative mt-2 text-sm text-silver">{service.summary}</p>
            <ul class="relative mt-4 space-y-2">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2 text-sm text-silver">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-silver" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a
              href={waLink(`Hola OptiSain, quiero cotizar: ${service.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Cotizar ${service.name} por WhatsApp`}
              class="relative -mb-2 mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-amber transition-transform hover:translate-x-0.5"
            >
              Cotizar
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-20" data-reveal-group>
      <div class="text-center">
        <h3 class="text-balance font-heading text-2xl font-bold text-gainsboro sm:text-3xl" data-reveal>
          Soluciones completas
        </h3>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          combos.map((combo) => (
            <div
              class="combo-card relative rounded-2xl bg-gunmetal/40 p-[1px]"
              data-reveal
            >
              <div class="combo-border absolute inset-0 rounded-2xl" aria-hidden="true" />
              <div class="relative h-full rounded-2xl bg-obsidian p-6">
                <h4 class="font-heading text-lg font-semibold text-gainsboro">{combo.name}</h4>
                <p class="mt-2 text-sm text-silver">{combo.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .combo-border {
    background: conic-gradient(
      from var(--angle, 0deg),
      transparent 0%,
      #ffb547 12%,
      transparent 28%
    );
    animation: spin-border 5s linear infinite;
  }

  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes spin-border {
    to {
      --angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .combo-border {
      animation: none;
    }
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterButtons.forEach((b) => {
        const active = b === btn;
        b.dataset.active = String(active);
        b.setAttribute('aria-pressed', String(active));
      });

      cards.forEach((card) => {
        const match = filter === 'todos' || card.dataset.serviceLine === filter;
        card.style.display = match ? '' : 'none';
      });
    });
  });
</script>
