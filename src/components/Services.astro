---
import Icon from '@/components/Icon.astro';
import { lines, services, combos } from '@/data/services';
import { waLink } from '@/config';

const filterClass =
  'min-h-11 rounded-full border border-gray/40 px-5 py-2 text-sm font-medium text-silver transition-colors duration-300 hover:border-silver hover:text-gainsboro data-[active=true]:border-gainsboro data-[active=true]:bg-gainsboro data-[active=true]:text-obsidian';
---

<section id="servicios" class="relative py-20 sm:py-40" aria-label="Servicios">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="mx-auto max-w-3xl text-center" data-reveal-group>
      <h2 class="text-balance font-heading text-3xl font-bold tracking-tight text-gainsboro sm:text-5xl" data-reveal>
        Todo lo que tu negocio necesita para crecer en línea
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-silver" data-reveal>
        Elige una línea o mira todos los servicios. Cada uno con un alcance claro, sin precios
        escondidos: cotiza directo por WhatsApp.
      </p>
    </div>

    <div
      class="mt-14 flex flex-wrap justify-center gap-2.5"
      role="group"
      aria-label="Filtrar servicios por línea"
      data-filters
    >
      <button type="button" class={filterClass} data-filter="todos" data-active="true" aria-pressed="true">
        Todos
      </button>
      {
        lines.map((line) => (
          <button
            type="button"
            class={filterClass}
            data-filter={line.id}
            data-active="false"
            aria-pressed="false"
          >
            {line.label}
          </button>
        ))
      }
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal-group
      data-services-grid
    >
      {
        services.map((service) => (
          <article
            class="group relative flex flex-col rounded-2xl border border-gray/25 bg-obsidian/55 p-8 transition-colors duration-500 hover:border-silver/45 hover:bg-gunmetal/20"
            data-reveal
            data-service-card
            data-service-line={service.line}
          >
            <Icon name={service.icon} class="h-7 w-7 text-silver transition-colors duration-500 group-hover:text-amber" />
            <h3 class="mt-6 font-heading text-xl font-semibold text-gainsboro">{service.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-silver">{service.summary}</p>
            <ul class="mt-6 space-y-2.5 border-t border-gray/20 pt-6">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-silver">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-gray" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a
              href={waLink(`Hola OptiSain, quiero cotizar: ${service.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Cotizar ${service.name} por WhatsApp`}
              class="mt-auto inline-flex min-h-11 items-center gap-2 pt-6 text-sm font-semibold text-amber"
            >
              Cotizar
              <svg
                class="transition-transform duration-300 group-hover:translate-x-1"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-32" data-reveal-group>
      <h3
        class="text-balance text-center font-heading text-2xl font-bold tracking-tight text-gainsboro sm:text-4xl"
        data-reveal
      >
        Soluciones completas
      </h3>

      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          combos.map((combo) => (
            <div
              class="rounded-2xl border border-gray/25 bg-gunmetal/20 p-7 transition-colors duration-500 hover:border-silver/45"
              data-reveal
            >
              <h4 class="font-heading text-lg font-semibold text-gainsboro">{combo.name}</h4>
              <p class="mt-3 text-sm leading-relaxed text-silver">{combo.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterButtons.forEach((b) => {
        const active = b === btn;
        b.dataset.active = String(active);
        b.setAttribute('aria-pressed', String(active));
      });

      cards.forEach((card) => {
        const match = filter === 'todos' || card.dataset.serviceLine === filter;
        card.style.display = match ? '' : 'none';
      });
    });
  });
</script>
