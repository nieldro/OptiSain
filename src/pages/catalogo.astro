---
// Catálogo imprimible: se exporta a PDF con scripts/generate-catalogo.mjs (public/catalogo-optisain.pdf).
import '@fontsource-variable/lexend/wght.css';
import '@fontsource-variable/manrope/wght.css';
import { lines, services, combos } from '@/data/services';
import { plans, included, planSteps } from '@/data/plans';
import { WHATSAPP_DISPLAY, SITE_URL } from '@/config';

const byLine = (id: string) => services.filter((s) => s.line === id);
const pageOne = ['presencia-web', 'marca-crecimiento', 'automatizacion-ia'];
const pageTwo = ['datos', 'soporte'];
const lineOf = (id: string) => lines.find((l) => l.id === id)!;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Catálogo de servicios | OptiSain</title>
  </head>
  <body>
    <!-- Portada -->
    <section class="page cover">
      <img src="/logo/optisain-logo-gainsboro.svg" alt="OptiSain" class="cover-logo" />
      <div>
        <p class="kicker">Catálogo 2026</p>
        <h1>Tu negocio en línea, sin enredos.</h1>
        <p class="lead">
          Páginas web, tiendas, chatbots con IA, automatizaciones y dashboards para negocios en Colombia. Un solo
          equipo y todo funcionando cuando te lo entregamos.
        </p>
      </div>
      <div class="cover-foot">
        <p><strong>{WHATSAPP_DISPLAY}</strong></p>
        <p>{SITE_URL.replace('https://', '')}</p>
      </div>
    </section>

    <!-- Servicios 1 -->
    <section class="page">
      <h2 class="page-title">Lo que hacemos</h2>
      {
        pageOne.map((id) => (
          <div class="block">
            <h3 class="line-title">{lineOf(id).label} <span>{lineOf(id).tagline}</span></h3>
            <div class="grid">
              {byLine(id).map((s) => (
                <article class="card">
                  <h4>{s.name}</h4>
                  <p>{s.summary}</p>
                  <ul>{s.includes.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <!-- Servicios 2 -->
    <section class="page">
      <h2 class="page-title">Datos, soporte y paquetes</h2>
      {
        pageTwo.map((id) => (
          <div class="block">
            <h3 class="line-title">{lineOf(id).label} <span>{lineOf(id).tagline}</span></h3>
            <div class="grid">
              {byLine(id).map((s) => (
                <article class="card">
                  <h4>{s.name}</h4>
                  <p>{s.summary}</p>
                  <ul>{s.includes.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
                </article>
              ))}
            </div>
          </div>
        ))
      }
      <div class="block">
        <h3 class="line-title">Soluciones completas <span>Varios servicios en un solo paquete.</span></h3>
        <div class="grid four">
          {combos.map((c) => (
            <article class="card combo">
              <h4>{c.name}</h4>
              <p>{c.description}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="cta">
        <h3>¿Listo para poner tu negocio en órbita?</h3>
        <p>Escríbenos y te respondemos el mismo día. El diagnóstico de 15 minutos es gratis.</p>
        <p class="cta-wa">{WHATSAPP_DISPLAY}</p>
      </div>
    </section>

    <!-- Planes -->
    <section class="page">
      <h2 class="page-title">Planes para tu página web</h2>
      <p class="lead small">Todo adentro: diseño, dominio, hosting, correos y 12 meses de mantenimiento.</p>
      <div class="plans">
        {plans.map((p) => (
          <article class={`plan ${p.featured ? 'featured' : ''}`}>
            {p.featured && <span class="badge">El más elegido</span>}
            <h4>{p.name}</h4>
            <p class="tag">{p.tagline}</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <p class="deliver">{p.delivery}</p>
            <p class="installments">Pídenos la cotización por WhatsApp. Hay opción de pago en cuotas.</p>
          </article>
        ))}
      </div>

      <h3 class="line-title" style="margin-top: 6mm">Va incluido en todos los planes</h3>
      <div class="grid four included">
        {included.map((i) => (
          <article class="card">
            <h4>{i.title}</h4>
            <p>{i.text}</p>
          </article>
        ))}
      </div>

      <h3 class="line-title" style="margin-top: 6mm">Así arrancamos</h3>
      <ol class="steps">
        {planSteps.map((s, i) => (
          <li>
            <span class="n">0{i + 1}</span>
            <div><h4>{s.title}</h4><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      <p class="legal">
        Todos los servicios se cotizan según el alcance: escríbenos al {WHATSAPP_DISPLAY} y recibe tu propuesta.
        Condiciones completas en {SITE_URL.replace('https://', '')}/terminos/.
      </p>
    </section>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  :root {
    --obsidian: #161516;
    --gunmetal: #2c4057;
    --gainsboro: #d3d8e2;
    --silver: #939baa;
    --gray: #606a7a;
    --amber: #ffb547;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background: var(--obsidian);
    color: var(--gainsboro);
    font-family: 'Manrope Variable', 'Manrope', sans-serif;
    font-size: 9.2pt;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'Lexend Variable', 'Lexend', sans-serif;
    color: var(--gainsboro);
  }

  .page {
    width: 210mm;
    height: 297mm;
    padding: 13mm 15mm 10mm;
    overflow: hidden;
    break-after: page;
    background:
      radial-gradient(120mm 80mm at 100% 0%, rgba(44, 64, 87, 0.55), transparent 70%),
      var(--obsidian);
  }

  .page:last-child {
    break-after: auto;
  }

  .cover {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22mm 20mm;
    background:
      radial-gradient(150mm 110mm at 85% 18%, rgba(255, 181, 71, 0.16), transparent 62%),
      radial-gradient(160mm 120mm at 100% 100%, rgba(44, 64, 87, 0.8), transparent 70%),
      var(--obsidian);
  }

  .cover-logo {
    height: 20mm;
    width: auto;
    align-self: flex-start;
  }

  .kicker {
    color: var(--amber);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 9pt;
  }

  .cover h1 {
    margin-top: 6mm;
    font-size: 40pt;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lead {
    margin-top: 7mm;
    max-width: 130mm;
    font-size: 12pt;
    color: var(--silver);
    line-height: 1.55;
  }

  .lead.small {
    margin-top: 2mm;
    font-size: 10pt;
    max-width: none;
  }

  .cover-foot {
    border-top: 1px solid var(--gray);
    padding-top: 6mm;
    color: var(--silver);
    font-size: 11pt;
  }

  .cover-foot strong {
    color: var(--amber);
    font-size: 16pt;
    font-family: 'Lexend Variable', sans-serif;
  }

  .page-title {
    font-size: 20pt;
    letter-spacing: -0.01em;
    padding-bottom: 4mm;
    border-bottom: 1px solid rgba(255, 181, 71, 0.45);
  }

  .block {
    margin-top: 6mm;
  }

  .line-title {
    font-size: 11.5pt;
    margin-bottom: 2.5mm;
  }

  .line-title span {
    margin-left: 2mm;
    font-family: 'Manrope Variable', sans-serif;
    font-weight: 500;
    font-size: 8.8pt;
    color: var(--silver);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3mm;
  }

  .grid.four {
    grid-template-columns: repeat(4, 1fr);
  }

  .card {
    border: 1px solid rgba(96, 106, 122, 0.45);
    border-radius: 3mm;
    padding: 3.5mm;
    background: rgba(22, 21, 22, 0.6);
  }

  .card h4 {
    font-size: 9.6pt;
    margin-bottom: 1mm;
  }

  .card p {
    color: var(--silver);
    font-size: 8pt;
    line-height: 1.4;
  }

  .card ul {
    margin-top: 2mm;
    padding-left: 3.2mm;
    color: var(--silver);
    font-size: 7.6pt;
    line-height: 1.35;
  }

  .card li {
    margin-top: 0.6mm;
  }

  .card.combo {
    border-color: rgba(255, 181, 71, 0.4);
    background: rgba(44, 64, 87, 0.3);
  }

  .included .card {
    padding: 2.4mm 3mm;
  }

  .included .card h4 {
    font-size: 8.6pt;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4mm;
    margin-top: 5mm;
  }

  .plan {
    position: relative;
    border: 1px solid rgba(96, 106, 122, 0.5);
    border-radius: 3.5mm;
    padding: 5mm 4.5mm;
    background: rgba(22, 21, 22, 0.65);
  }

  .plan.featured {
    border-color: var(--amber);
    background: rgba(44, 64, 87, 0.4);
  }

  .badge {
    position: absolute;
    top: -2.6mm;
    left: 4.5mm;
    background: var(--amber);
    color: var(--obsidian);
    font-weight: 700;
    font-size: 7pt;
    padding: 0.8mm 2.4mm;
    border-radius: 99mm;
  }

  .plan h4 {
    font-size: 13pt;
  }

  .plan .tag {
    margin-top: 1.2mm;
    min-height: 8mm;
    color: var(--silver);
    font-size: 8pt;
  }

  .plan .was {
    margin-top: 3mm;
    color: var(--silver);
    font-size: 8pt;
  }

  .plan .price {
    font-family: 'Lexend Variable', sans-serif;
    font-weight: 700;
    font-size: 19pt;
    letter-spacing: -0.02em;
    color: var(--gainsboro);
  }

  .plan .save {
    color: var(--amber);
    font-weight: 700;
    font-size: 8.4pt;
  }

  .plan .fine {
    color: var(--silver);
    font-size: 7.4pt;
  }

  .plan ul {
    margin-top: 3.5mm;
    padding-top: 3mm;
    border-top: 1px solid rgba(96, 106, 122, 0.35);
    padding-left: 3.4mm;
    color: var(--silver);
    font-size: 8pt;
    line-height: 1.4;
  }

  .plan li {
    margin-top: 1mm;
  }

  .plan .deliver {
    margin-top: 3mm;
    font-size: 7.4pt;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--silver);
  }

  .plan .installments {
    margin-top: 3mm;
    padding: 2.4mm 3mm;
    border: 1px solid rgba(96, 106, 122, 0.4);
    border-radius: 2.4mm;
    color: var(--silver);
    font-size: 7.6pt;
  }

  .plan .installments strong {
    color: var(--gainsboro);
  }

  .cta {
    margin-top: 14mm;
    padding: 10mm 9mm;
    border: 1px solid rgba(255, 181, 71, 0.5);
    border-radius: 4mm;
    background: radial-gradient(90mm 50mm at 100% 0%, rgba(255, 181, 71, 0.14), transparent 70%), rgba(44, 64, 87, 0.3);
  }

  .cta h3 {
    font-size: 17pt;
    letter-spacing: -0.01em;
  }

  .cta p {
    margin-top: 2.5mm;
    color: var(--silver);
    font-size: 10pt;
  }

  .cta .cta-wa {
    margin-top: 5mm;
    color: var(--amber);
    font-family: 'Lexend Variable', sans-serif;
    font-weight: 700;
    font-size: 20pt;
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3mm;
  }

  .steps li {
    display: flex;
    gap: 2.6mm;
    border: 1px solid rgba(255, 181, 71, 0.35);
    border-radius: 3mm;
    padding: 3.4mm;
    background: rgba(44, 64, 87, 0.25);
  }

  .steps .n {
    color: var(--amber);
    font-family: 'Lexend Variable', sans-serif;
    font-weight: 700;
    font-size: 9pt;
  }

  .steps h4 {
    font-size: 9.4pt;
  }

  .steps p {
    margin-top: 0.8mm;
    color: var(--silver);
    font-size: 7.8pt;
    line-height: 1.4;
  }

  .legal {
    margin-top: 4mm;
    color: var(--silver);
    font-size: 7.6pt;
    text-align: center;
  }
</style>
