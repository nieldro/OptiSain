---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import Services from '@/components/Services.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import WhyOptisain from '@/components/WhyOptisain.astro';
import ClosingBand from '@/components/ClosingBand.astro';
import Faq from '@/components/Faq.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <Marquee />
    <Services />
    <HowWeWork />
    <WhyOptisain />
    <ClosingBand />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFab />
</Layout>

<script>
  import { initSmoothScroll } from '@/lib/smooth-scroll';
  import { initReveal } from '@/lib/reveal';
  import { initHeadingReveal } from '@/lib/heading-reveal';
  import { initStarfield } from '@/lib/starfield';

  initSmoothScroll();
  initStarfield();
  initHeadingReveal();
  initReveal();
</script>
